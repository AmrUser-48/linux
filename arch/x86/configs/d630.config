# DELL LATITUDE D630 / Core 2 Duo / Intel 965GM-GMA X3100
# Minimal desktop/laptop profile.
#
# Intended use:
#   make x86_64_defconfig
#   ./scripts/kconfig/merge_config.sh -m .config arch/x86/configs/d630.config
#   make olddefconfig
#
# Keep the base x86_64 configuration for generic kernel infrastructure,
# then explicitly disable large unused hardware/protocol families here.

# Stable, human-readable kernel/package names; do not append SCM commits.
CONFIG_LOCALVERSION_AUTO=n

# CPU / x86
CONFIG_SMP=y
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_X86_NATIVE_CPU=n
CONFIG_NUMA=n
CONFIG_HYPERVISOR_GUEST=n
CONFIG_PARAVIRT=n
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=n
CONFIG_XEN=n
CONFIG_VIRTIO=n
CONFIG_VFIO=n
CONFIG_AMD_IOMMU=n
CONFIG_INTEL_IOMMU=n
CONFIG_IRQ_REMAP=n

# Firmware / boot: D630 is legacy-BIOS hardware
# Keep UEFI/EFISTUB out; use a compact XZ-compressed legacy kernel image.
CONFIG_KERNEL_XZ=y
CONFIG_KERNEL_GZIP=n
CONFIG_KERNEL_LZ4=n
CONFIG_KERNEL_LZO=n
CONFIG_KERNEL_ZSTD=n
CONFIG_EFI=n
CONFIG_EFI_STUB=n
CONFIG_EFI_MIXED=n

# Power management / laptop
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_DOCK=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_VIDEO=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_PM_SLEEP=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_HPET=y
CONFIG_X86_THERMAL_VECTOR=y

# Dell laptop/platform support
CONFIG_DCDBAS=y
CONFIG_DELL_LAPTOP=y
CONFIG_DELL_SMBIOS=y
CONFIG_DELL_SMBIOS_WMI=y
CONFIG_DELL_SMBIOS_SMM=y
CONFIG_DELL_WMI=y
CONFIG_DELL_PC=y
CONFIG_DELL_SMO8800=y

# Intel 965GM / GMA X3100 graphics
CONFIG_AGP=y
CONFIG_AGP_INTEL=m
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_I915_GVT_KVMGT=n
CONFIG_DRM_I915_PXP=n
CONFIG_DRM_VIRTIO_GPU=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_VMWGFX=n
CONFIG_DRM_QXL=n
CONFIG_DRM_AST=n
CONFIG_DRM_BOCHS=n
CONFIG_DRM_VBOXVIDEO=n
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_VGA_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Core storage
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_SCSI_CDROM=y
CONFIG_USB_STORAGE=m
CONFIG_BLK_DEV_LOOP=y

# USB 2.0 / Android device access
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_XHCI_HCD=n
CONFIG_USB_UAS=n
CONFIG_USB_PRINTER=n
CONFIG_USB_MON=n
CONFIG_USB_SERIAL=n

# Android tethering / USB networking
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m
# Keep modern phone tethering available without putting it in the core.
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDC_EEM=n
CONFIG_USB_NET_QMI_WWAN=n
CONFIG_WWAN=n

# Optional QEMU TAP networking; software-user networking needs no kernel addon.
CONFIG_TUN=m

# Ethernet: retain the D630 Broadcom driver as a loadable fallback.
# This particular machine does not currently expose an Ethernet PCI device.
CONFIG_NETDEVICES=y
CONFIG_TIGON3=m

# Wi-Fi: this machine has Intel PRO/Wireless 3945ABG (8086:4222).
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_IWLEGACY=y
CONFIG_IWL3945=y
CONFIG_IWL4965=n
CONFIG_B43=n
CONFIG_B43_PCI_AUTOSELECT=n
CONFIG_B43_BCMA=n
CONFIG_B43_SSB=n
CONFIG_B43_PHY_G=n
CONFIG_B43_PHY_N=n
CONFIG_B43_PHY_LP=n
CONFIG_IWLWIFI=n

# Keyboard / touchpad / TrackPoint
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y

# Serial console / legacy serial port (D630 has DB9 serial)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PNP=y

# Audio: Intel HDA
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_HWDEP=n
CONFIG_SND_HDA_INPUT_BEEP=n

# I2C / SMBus
CONFIG_I2C=y
CONFIG_I2C_I801=y
CONFIG_I2C_ALGOBIT=y

# Core 2 power/temperature management
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_X86_INTEL_IDLE=y
CONFIG_THERMAL=y
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=y

# D630 SigmaTel HD Audio codec
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_I915=n
CONFIG_SND_SEQUENCER=n
CONFIG_SND_RAWMIDI=n

# USB HID for ordinary external keyboard/mouse devices
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# Enable joystick/gamepad driver menu; keep the legacy jsX interface loadable.
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_JOYDEV=m
# Optional userspace-created/virtual input devices.
CONFIG_INPUT_UINPUT=m
# HIDRAW is a boolean option in this kernel, so keep the raw HID interface built-in.
CONFIG_HIDRAW=y

# Real-time clock
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"

# zram: built into the kernel, LZ4 default
CONFIG_ZSMALLOC=y
CONFIG_ZSMALLOC_STAT=n
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4HC=n
CONFIG_ZRAM_BACKEND_ZSTD=n
CONFIG_ZRAM_BACKEND_DEFLATE=n
CONFIG_ZRAM_BACKEND_842=n
CONFIG_ZRAM_BACKEND_LZO=n
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_WRITEBACK=n

# Filesystems
# Local/removable filesystem support
CONFIG_FAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y

CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_UDF_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SQUASHFS=n
CONFIG_NFS_FS=n
CONFIG_CIFS=n
CONFIG_9P_FS=n
CONFIG_F2FS_FS=n
CONFIG_XFS_FS=n
CONFIG_REISERFS_FS=n
CONFIG_JFS_FS=n
CONFIG_OCFS2_FS=n
CONFIG_GFS2_FS=n

# No DVB / TV tuner / V4L2 multimedia stack
CONFIG_MEDIA_SUPPORT=n
CONFIG_DVB_CORE=n
CONFIG_VIDEO_DEV=n
CONFIG_CEC_CORE=n

# Peripheral families not used on this laptop
CONFIG_BLUETOOTH=n
CONFIG_BT=n
CONFIG_IEEE1394=n
CONFIG_FIREWIRE=n
CONFIG_PCCARD=n
CONFIG_PARPORT=n
CONFIG_INFINIBAND=n
CONFIG_HAMRADIO=n
CONFIG_CAN=n
CONFIG_ISDN=n
CONFIG_ATM=n
CONFIG_IRDA=n
CONFIG_NFC=n
CONFIG_WIMAX=n
CONFIG_RDS=n
CONFIG_SCTP=n
CONFIG_DCCP=n
CONFIG_TIPC=n
CONFIG_6LOWPAN=n
CONFIG_WPAN=n
CONFIG_IEEE802154=n

# Unused network protocol families
CONFIG_IPX=n
CONFIG_APPLETALK=n
CONFIG_DECNET=n
CONFIG_ECONET=n
CONFIG_X25=n
CONFIG_L2TP=n
CONFIG_PHONET=n
CONFIG_6PACK=n
CONFIG_SLIP=n
CONFIG_PPP=n
CONFIG_NETROM=n
CONFIG_AX25=n
CONFIG_ROSE=n

# USB gadget/function stacks are not needed on the laptop host
CONFIG_USB_GADGET=n
CONFIG_USB_CONFIGFS=n

# Virtual/server-oriented device families
CONFIG_VIRTIO_PCI=n
CONFIG_VIRTIO_NET=n
CONFIG_VIRTIO_BLK=n
CONFIG_VIRTIO_INPUT=n
CONFIG_HYPERV=n
CONFIG_VMWARE_BALLOON=n
CONFIG_VMWARE_VMCI=n

# GPU/display drivers for hardware this D630 does not have
CONFIG_DRM_GMA500=n
CONFIG_DRM_MGAG200=n

# Unused network hardware families (retain only Broadcom Ethernet + possible D630 Wi-Fi)
CONFIG_NET_TULIP=n
CONFIG_E100=n
CONFIG_E1000=n
CONFIG_E1000E=n
CONFIG_SKY2=n
CONFIG_R8169=n
CONFIG_FORCEDETH=n
CONFIG_8139TOO=n
CONFIG_BNX2=n
CONFIG_BNX2X=n
CONFIG_IGC=n
CONFIG_IGB=n

# Unused USB/network WWAN families
CONFIG_USB_NET_CDC_MBIM=n
CONFIG_USB_NET_CDC_SUBSET=n
CONFIG_USB_NET_AX8817X=n
CONFIG_USB_NET_AX88179_178A=n
CONFIG_USB_NET_RTL8152=n

# Userspace compatibility / optional execution helpers.
# Wine itself does not require a special kernel subsystem, but binfmt_misc
# is useful when registering direct Windows-EXE execution handlers.
CONFIG_BINFMT_MISC=m

# Kernel debug / development overhead
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
CONFIG_KALLSYMS_ALL=n
CONFIG_DEBUG_WX=n
CONFIG_SCHEDSTATS=n
CONFIG_BLK_DEV_IO_TRACE=n
CONFIG_PROFILING=n
CONFIG_KPROBES=n
CONFIG_FTRACE=n
CONFIG_KCOV=n
CONFIG_KUNIT=n


# D630 second-pass pruning: keep the kernel desktop/laptop-focused.

# Keep module infrastructure available for udev/initramfs, but do not build
# unnecessary driver families as modules. Do not unload modules at runtime.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=n
CONFIG_MODULE_COMPRESS=n
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SRCVERSION_ALL=n
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=n
CONFIG_MODULE_SIG_FORCE=n
CONFIG_MODULE_DECOMPRESS=n
CONFIG_MODULE_DEBUG=n

# 250 Hz is a better latency/overhead balance for this 2-core laptop.
CONFIG_HZ_250=y
CONFIG_HZ_1000=n

# Legacy BIOS console/framebuffer fallback; i915 is the primary GPU driver.
CONFIG_FB_VESA=y
CONFIG_FB_EFI=n
CONFIG_FB_UVESA=n
CONFIG_FB_VGA16=n

# i915 debug/virtualization features are unnecessary on GMA X3100.
CONFIG_DRM_I915_CAPTURE_ERROR=n
CONFIG_DRM_I915_USERPTR=n
CONFIG_DRM_I915_COMPRESS_ERROR=n
CONFIG_DRM_VGEM=n
CONFIG_DRM_CIRRUS_QEMU=n
CONFIG_DRM_SIS=n
CONFIG_DRM_VIA=n
CONFIG_DRM_SAVAGE=n

# PCI hotplug/advanced virtualization features not used by this platform.
CONFIG_PCI_IOV=n
CONFIG_PCI_ATS=n
CONFIG_PCI_PRI=n
CONFIG_PCI_PASID=n
CONFIG_PCI_STUB=n
CONFIG_HOTPLUG_PCI_SHPC=n

# USB-C/USB4/Thunderbolt belong to newer systems.
CONFIG_TYPEC=n
CONFIG_USB_TYPEC=n
CONFIG_UCSI=n
CONFIG_USB_ROLE_SWITCH=n
CONFIG_THUNDERBOLT=n
CONFIG_USB4=n
CONFIG_USB_PD=n

# Unused USB peripheral classes.
CONFIG_USB_AUDIO=n
CONFIG_USB_ACM=n
CONFIG_USB_WWAN=n
CONFIG_USBIP_CORE=n
CONFIG_USB_MIDI_GADGET=n

# Unused input classes.
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_USB_HIDDEV=n
CONFIG_HID_MULTITOUCH=n

# Keep only the wireless families known to have shipped in D630 variants.
CONFIG_ATH=n
CONFIG_ATH9K=n
CONFIG_ATH10K=n
CONFIG_ATH11K=n
CONFIG_RTW88=n
CONFIG_RTW89=n
CONFIG_RTL8XXXU=n
CONFIG_MT76=n
CONFIG_MWIFIEX=n
CONFIG_LIBERTAS=n
CONFIG_ZD1211RW=n
CONFIG_P54_COMMON=n
CONFIG_RSI_91X=n
CONFIG_PRISM54=n

# No SD/MMC, PCMCIA/CardBus, or peripheral flash stack.
CONFIG_MMC=n
CONFIG_PCMCIA=n
CONFIG_MTD=n
CONFIG_SPI=n
CONFIG_I3C=n
CONFIG_W1=n

# No FireWire, DVB/TV/camera/multimedia capture, or Bluetooth.

# No miscellaneous radio/telephony/bus families.

# Unused legacy network protocol families.

# No USB gadget/function framework on the laptop host.

# No virtualization/server device families.

# Unused network hardware; keep Broadcom tg3 and possible D630 Wi-Fi only.

# Unused USB networking/WWAN hardware.

# No watchdog, TPM, crash dump, or kernel development/debug overhead.
CONFIG_WATCHDOG=n
CONFIG_TCG_TPM=n
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_CRASH_DUMP=n

# Btrfs and NTFS3 remain built-in; zram remains built-in with LZ4.
CONFIG_ZRAM_TRACK_ENTRY_ACTIME=n
CONFIG_ZRAM_MEMORY_TRACKING=n
CONFIG_ZRAM_MULTI_COMP=n

# Selected Debian amd64 userspace facilities (Linux 7.2)
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# Cgroups/namespaces used by systemd, containers and sandboxing.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CPUSETS=y
CONFIG_PROC_PID_CPUSET=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_SOCK_CGROUP_DATA=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CHECKPOINT_RESTORE=y

# eBPF, syscall filtering and LSMs selected for Debian desktop use.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_BPF_LSM=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_INTROSPECT_POLICY=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
CONFIG_SECURITY_APPARMOR_EXPORT_BINARY=y
CONFIG_SECURITY_APPARMOR_PARANOID_LOAD=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_LSM="landlock,lockdown,yama,apparmor,bpf"

# Standard userspace filesystem/event facilities.
CONFIG_FHANDLE=y
CONFIG_IO_URING=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_FUSE_FS=m
CONFIG_CUSE=m
CONFIG_OVERLAY_FS=m

# Debian-style nftables/iptables support retained across module pruning.
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
# Legacy iptables support for Debian compatibility; nftables remains primary.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_NETFILTER_NETLINK=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_CT_NETLINK=m
CONFIG_NF_LOG_SYSLOG=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_COMPAT=m
CONFIG_NETFILTER_XTABLES=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_POLICY=m
CONFIG_NETFILTER_XT_TARGET_CONNSECMARK=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_REJECT=m
CONFIG_NETFILTER_XT_TARGET_SECMARK=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m

# Legacy conntrack application helpers are unnecessary for ordinary desktop use.
CONFIG_NF_CONNTRACK_AMANDA=n
CONFIG_NF_CONNTRACK_FTP=n
CONFIG_NF_CONNTRACK_H323=n
CONFIG_NF_CONNTRACK_IRC=n
CONFIG_NF_CONNTRACK_BROADCAST=n
CONFIG_NF_CONNTRACK_NETBIOS_NS=n
CONFIG_NF_CONNTRACK_SNMP=n
CONFIG_NF_CONNTRACK_PPTP=n
CONFIG_NF_CONNTRACK_SANE=n
CONFIG_NF_CONNTRACK_SIP=n
CONFIG_NF_CONNTRACK_TFTP=n
CONFIG_NF_NAT_AMANDA=n
CONFIG_NF_NAT_FTP=n
CONFIG_NF_NAT_IRC=n
CONFIG_NF_NAT_SIP=n
CONFIG_NF_NAT_TFTP=n
