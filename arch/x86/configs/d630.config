# DELL LATITUDE D630 / Core 2 Duo / Intel 965GM-GMA X3100
# Minimal desktop/laptop profile.
#
# Intended use:
#   make x86_64_defconfig
#   ./scripts/kconfig/merge_config.sh -m .config arch/x86/configs/d630.config
#   make olddefconfig
#
# Keep the base x86_64 configuration for generic kernel infrastructure,
# then explicitly disable large unused hardware/protocol families here.

# CPU / x86
CONFIG_SMP=y
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_X86_NATIVE_CPU=n
CONFIG_NUMA=n
CONFIG_HYPERVISOR_GUEST=n
CONFIG_PARAVIRT=n
CONFIG_KVM=n
CONFIG_KVM_INTEL=n
CONFIG_XEN=n
CONFIG_VIRTIO=n
CONFIG_VFIO=n
CONFIG_AMD_IOMMU=n
CONFIG_INTEL_IOMMU=n
CONFIG_IRQ_REMAP=n

# Firmware / boot: D630 is legacy-BIOS hardware
CONFIG_EFI=n
CONFIG_EFI_STUB=n
CONFIG_EFI_MIXED=n

# Power management / laptop
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_DOCK=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_VIDEO=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_PM_SLEEP=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_HPET=y
CONFIG_X86_THERMAL_VECTOR=y

# Dell laptop/platform support
CONFIG_DCDBAS=y
CONFIG_DELL_LAPTOP=y
CONFIG_DELL_SMBIOS=y
CONFIG_DELL_SMBIOS_WMI=y
CONFIG_DELL_SMBIOS_SMM=y
CONFIG_DELL_WMI=y
CONFIG_DELL_PC=y
CONFIG_DELL_SMO8800=y

# Intel 965GM / GMA X3100 graphics
CONFIG_AGP=y
CONFIG_AGP_INTEL=y
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_I915_GVT_KVMGT=n
CONFIG_DRM_I915_PXP=n
CONFIG_DRM_VIRTIO_GPU=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_VMWGFX=n
CONFIG_DRM_QXL=n
CONFIG_DRM_AST=n
CONFIG_DRM_BOCHS=n
CONFIG_DRM_VBOXVIDEO=n
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_VGA_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Core storage
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_SCSI_CDROM=y
CONFIG_USB_STORAGE=y
CONFIG_BLK_DEV_LOOP=y

# USB 2.0 / Android device access
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_XHCI_HCD=n
CONFIG_USB_UAS=n
CONFIG_USB_PRINTER=n
CONFIG_USB_MON=n
CONFIG_USB_SERIAL=n

# Android tethering / USB networking
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_CDC_NCM=n
CONFIG_USB_NET_CDC_EEM=n
CONFIG_USB_NET_QMI_WWAN=n
CONFIG_WWAN=n

# Ethernet: D630 Broadcom Gigabit controller
CONFIG_NETDEVICES=y
CONFIG_TIGON3=y

# Wi-Fi variants shipped in D630 configurations:
# Intel 3945/4965 or Dell/Broadcom adapters.
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_IWLEGACY=y
CONFIG_IWL3945=y
CONFIG_IWL4965=y
CONFIG_B43=y
CONFIG_B43_PCI_AUTOSELECT=y
CONFIG_B43_BCMA=y
CONFIG_B43_SSB=y
CONFIG_B43_PHY_G=y
CONFIG_B43_PHY_N=y
CONFIG_B43_PHY_LP=y
CONFIG_IWLWIFI=n

# Keyboard / touchpad / TrackPoint
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y

# Serial console / legacy serial port (D630 has DB9 serial)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PNP=y

# Audio: Intel HDA
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_HWDEP=n
CONFIG_SND_HDA_INPUT_BEEP=n

# I2C / SMBus
CONFIG_I2C=y
CONFIG_I2C_I801=y
CONFIG_I2C_ALGOBIT=y

# Real-time clock
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"

# zram: built into the kernel, LZ4 default
CONFIG_ZSMALLOC=y
CONFIG_ZSMALLOC_STAT=n
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4HC=n
CONFIG_ZRAM_BACKEND_ZSTD=n
CONFIG_ZRAM_BACKEND_DEFLATE=n
CONFIG_ZRAM_BACKEND_842=n
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_WRITEBACK=n

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_UDF_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SQUASHFS=n
CONFIG_NFS_FS=n
CONFIG_CIFS=n
CONFIG_9P_FS=n
CONFIG_F2FS_FS=n
CONFIG_XFS_FS=n
CONFIG_REISERFS_FS=n
CONFIG_JFS_FS=n
CONFIG_OCFS2_FS=n
CONFIG_GFS2_FS=n

# No DVB / TV tuner / V4L2 multimedia stack
CONFIG_MEDIA_SUPPORT=n
CONFIG_DVB_CORE=n
CONFIG_VIDEO_DEV=n
CONFIG_CEC_CORE=n

# Peripheral families not used on this laptop
CONFIG_BLUETOOTH=n
CONFIG_BT=n
CONFIG_IEEE1394=n
CONFIG_FIREWIRE=n
CONFIG_PCCARD=n
CONFIG_PARPORT=n
CONFIG_INFINIBAND=n
CONFIG_HAMRADIO=n
CONFIG_CAN=n
CONFIG_ISDN=n
CONFIG_ATM=n
CONFIG_IRDA=n
CONFIG_NFC=n
CONFIG_WIMAX=n
CONFIG_NFC=n
CONFIG_RDS=n
CONFIG_SCTP=n
CONFIG_DCCP=n
CONFIG_TIPC=n
CONFIG_6LOWPAN=n
CONFIG_WPAN=n
CONFIG_IEEE802154=n

# Unused network protocol families
CONFIG_IPX=n
CONFIG_APPLETALK=n
CONFIG_DECNET=n
CONFIG_ECONET=n
CONFIG_X25=n
CONFIG_L2TP=n
CONFIG_PHONET=n
CONFIG_6PACK=n
CONFIG_SLIP=n
CONFIG_PPP=n
CONFIG_NETROM=n
CONFIG_AX25=n
CONFIG_ROSE=n

# USB gadget/function stacks are not needed on the laptop host
CONFIG_USB_GADGET=n
CONFIG_USB_CONFIGFS=n

# Virtual/server-oriented device families
CONFIG_VIRTUALIZATION=n
CONFIG_VIRTIO_PCI=n
CONFIG_VIRTIO_NET=n
CONFIG_VIRTIO_BLK=n
CONFIG_VIRTIO_INPUT=n
CONFIG_HYPERV=n
CONFIG_VMWARE_BALLOON=n
CONFIG_VMWARE_VMCI=n

# GPU/display drivers for hardware this D630 does not have
CONFIG_DRM_GMA500=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_MGAG200=n
CONFIG_DRM_AST=n

# Unused network hardware families (retain only Broadcom Ethernet + possible D630 Wi-Fi)
CONFIG_NET_TULIP=n
CONFIG_E100=n
CONFIG_E1000=n
CONFIG_E1000E=n
CONFIG_SKY2=n
CONFIG_R8169=n
CONFIG_FORCEDETH=n
CONFIG_8139TOO=n
CONFIG_BNX2=n
CONFIG_BNX2X=n
CONFIG_IGC=n
CONFIG_IGB=n

# Unused USB/network WWAN families
CONFIG_USB_NET_QMI_WWAN=n
CONFIG_USB_NET_CDC_MBIM=n
CONFIG_USB_NET_CDC_SUBSET=n
CONFIG_USB_NET_AX8817X=n
CONFIG_USB_NET_AX88179_178A=n
CONFIG_USB_NET_RTL8152=n
CONFIG_USB_NET_CDC_NCM=n

# Kernel debug / development overhead
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
CONFIG_KALLSYMS_ALL=n
CONFIG_DEBUG_WX=n
CONFIG_SCHEDSTATS=n
CONFIG_BLK_DEV_IO_TRACE=n
CONFIG_PROFILING=n
CONFIG_KPROBES=n
CONFIG_FTRACE=n
CONFIG_KCOV=n
CONFIG_KUNIT=n


# D630 second-pass pruning: keep the kernel desktop/laptop-focused.

# Kernel modules: retain module support for ordinary userspace/udev, but avoid
# module unloading/compression overhead. Hardware-specific drivers below are
# deliberately built-in or disabled.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=n
CONFIG_MODULE_FORCE_UNLOAD=n
CONFIG_MODULE_COMPRESS=n

# Scheduler/timers: lighter desktop baseline for a 2-core Core 2 laptop.
CONFIG_HZ_250=y
CONFIG_HZ_1000=n

# Legacy BIOS framebuffer fallback; i915 remains the primary graphics driver.
CONFIG_FB_VESA=y
CONFIG_FB_EFI=n
CONFIG_FB_UVESA=n
CONFIG_FB_VGA16=n

# i915 debugging/features not useful on this fixed Gen4/GMA X3100 target.
CONFIG_DRM_I915_CAPTURE_ERROR=n
CONFIG_DRM_I915_USERPTR=n
CONFIG_DRM_I915_COMPRESS_ERROR=n

# No newer GPU stacks.
CONFIG_DRM_VGEM=n
CONFIG_DRM_CIRRUS_QEMU=n
CONFIG_DRM_SIS=n
CONFIG_DRM_VIA=n
CONFIG_DRM_SAVAGE=n

# PCI capabilities not useful on this 965GM/ICH8M laptop.
CONFIG_PCI_IOV=n
CONFIG_PCI_ATS=n
CONFIG_PCI_PRI=n
CONFIG_PCI_PASID=n
CONFIG_PCI_STUB=n
CONFIG_HOTPLUG_PCI_SHPC=n

# USB-C/USB4/Thunderbolt belong to much newer systems.
CONFIG_TYPEC=n
CONFIG_USB_TYPEC=n
CONFIG_UCSI=n
CONFIG_USB_ROLE_SWITCH=n
CONFIG_THUNDERBOLT=n
CONFIG_USB4=n
CONFIG_USB_PD=n

# USB peripherals not used here.
CONFIG_USB_AUDIO=n
CONFIG_USB_ACM=n
CONFIG_USB_WWAN=n
CONFIG_USBIP_CORE=n
CONFIG_USB_MIDI_GADGET=n

# Input devices not present on the D630.
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_HIDRAW=n
CONFIG_USB_HIDDEV=n
CONFIG_HID_MULTITOUCH=n

# Wireless families not used by the D630 hardware variants we keep.
CONFIG_ATH=n
CONFIG_ATH9K=n
CONFIG_ATH10K=n
CONFIG_ATH11K=n
CONFIG_RTW88=n
CONFIG_RTW89=n
CONFIG_RTL8XXXU=n
CONFIG_MT76=n
CONFIG_MWIFIEX=n
CONFIG_LIBERTAS=n
CONFIG_ZD1211RW=n
CONFIG_P54_COMMON=n
CONFIG_RSI_91X=n
CONFIG_PRISM54=n

# Keep the D630's possible Wi-Fi hardware only:
# Intel 3945/4965 legacy and Broadcom b43 are configured above.

# No SD/MMC/embedded-media stack unless it is explicitly needed later.
CONFIG_MMC=n

# No smart-card/PCMCIA expansion stack.
CONFIG_PCMCIA=n

# Old laptop has no need for FireWire/DVB/TV/camera/multimedia capture.

# No miscellaneous bus/flash peripheral infrastructure.
CONFIG_MTD=n
CONFIG_SPI=n
CONFIG_I3C=n
CONFIG_W1=n

# No watchdog hardware required for this laptop.
CONFIG_WATCHDOG=n

# No TPM/fingerprint stack in the minimal profile.
CONFIG_TCG_TPM=n

# No kernel crash-dump/kexec machinery for this fixed desktop kernel.
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_CRASH_DUMP=n

# No architecture virtualization guests/hosts.

# Block/filesystem pruning: keep normal local-disk desktop filesystems,
# including Btrfs and NTFS3, while dropping network/cluster filesystems.

# zram is built into the kernel and uses fast LZ4 compression.
CONFIG_ZRAM_TRACK_ENTRY_ACTIME=n
CONFIG_ZRAM_MEMORY_TRACKING=n
CONFIG_ZRAM_MULTI_COMP=n

# Keep these filesystems built-in.
